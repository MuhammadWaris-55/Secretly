FROM ghcr.io/gitleaks/gitleaks:v8.30.1 AS gitleaks

FROM node:24-bookworm-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git tini \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gitleaks /usr/bin/gitleaks /usr/local/bin/gitleaks

ENV NODE_ENV=production
COPY package.json package-lock.json ./
# The root prepare script invokes Husky, which is omitted from this runtime image.
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY tsconfig.json ./
COPY config/gitleaks.toml ./config/gitleaks.toml
COPY src/core ./src/core
COPY src/worker ./src/worker

ENV PORT=3001
EXPOSE 3001
USER node
RUN gitleaks version && git --version && node --import tsx --version

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD ["node", "-e", "fetch('http://127.0.0.1:' + process.env.PORT + '/healthz', { signal: AbortSignal.timeout(4000) }).then(r => { process.exitCode = r.ok ? 0 : 1 }, () => { process.exitCode = 1 })"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "--import", "tsx", "src/worker/index.ts"]
