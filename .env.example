# Copy this file to .env.local and fill in real values.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_KEY=
DATABASE_URL=
DIRECT_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Optional. Set both on the worker to enable Resend delivery.
RESEND_API_KEY=
EMAIL_FROM=
