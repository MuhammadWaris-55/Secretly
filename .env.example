# Copy this file to .env.local and fill in real values.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_KEY=
DATABASE_URL=
DIRECT_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Optional worker health port if PORT is shared with the web app.
# WORKER_PORT=3001

# Optional. Set both on the worker to enable Resend delivery.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: automatic Vercel worker capacity, ONLY on the long-lived Render web service.
# Leave disabled locally, on previews, and on the Vercel worker itself.
# WORKER_AUTOSCALE=true
# WORKER_VERCEL_TOKEN=             # Vercel access token, scoped to your team
# WORKER_VERCEL_PROJECT_ID=        # prj_... of secretly-worker
# WORKER_VERCEL_TEAM_ID=           # team_... owning that project
# WORKER_VERCEL_REGION=           # Same region as your tested worker, near Neon
# WORKER_IDLE_SECONDS=300         # 60–900; default five minutes
